# Environment Variables - WhatsAssist Backend
# Copy this file to .env and fill in your actual values

# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT Configuration ────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── Database ─────────────────────────────────────────
# SQLite DB file path (relative to /backend)
DATABASE_PATH=./data/whatsassist.db

# ── Meta WhatsApp Cloud API ──────────────────────────
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_WABA_ID=your_whatsapp_business_account_id_here
META_WEBHOOK_VERIFY_TOKEN=whatsassist_webhook_verify_token_2024

# ── Gemini AI ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Frontend URL (for CORS) ───────────────────────────
FRONTEND_URL=http://localhost:5173
